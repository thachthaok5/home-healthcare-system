<mxfile host="app.diagrams.net" scale="1" border="0">
  <diagram name="Trang-1" id="K6WZxNNJhCykNgEyu7ko">
    <mxGraphModel dx="13883" dy="5417" grid="1" gridSize="17" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ERD v2 - Home Healthcare Management System\n\nhide circle\nskinparam defaultFontSize 30\nskinparam titleFontSize 30\nskinparam entityFontSize 30\nskinparam ArrowFontSize 24\nskinparam linetype ortho\n\nskinparam entity {\n  BackgroundColor #F8FAFC\n  BorderColor #475569\n  FontColor #0F172A\n}\n\nskinparam ArrowColor #475569\n\n&#39; ==================================================\n&#39; 1. AUTHENTICATION AND RBAC\n&#39; ==================================================\n\nentity \&quot;users\&quot; as users {\n  * user_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  role_id : BIGINT &lt;&lt;FK&gt;&gt;\n  username : VARCHAR(100) &lt;&lt;UQ&gt;&gt;\n  email : VARCHAR(255) &lt;&lt;UQ&gt;&gt;\n  password_hash : TEXT\n  status : VARCHAR(30)\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\nentity \&quot;roles\&quot; as roles {\n  * role_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  role_name : VARCHAR(100) &lt;&lt;UQ&gt;&gt;\n  description : TEXT NULL\n}\n\nentity \&quot;permissions\&quot; as permissions {\n  * permission_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  permission_code : VARCHAR(100) &lt;&lt;UQ&gt;&gt;\n  description : TEXT NULL\n}\n\nentity \&quot;role_permissions\&quot; as role_permissions {\n  * role_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  * permission_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n}\n\n&#39; ==================================================\n&#39; 2. CUSTOMERS AND EMPLOYEES\n&#39; ==================================================\n\nentity \&quot;customers\&quot; as customers {\n  * customer_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  user_id : BIGINT &lt;&lt;FK, UQ, NULL&gt;&gt;\n  full_name : VARCHAR(150)\n  phone : VARCHAR(30) NULL\n  date_of_birth : DATE NULL\n  address : TEXT NULL\n  lat : NUMERIC(9,6) NULL\n  lon : NUMERIC(9,6) NULL\n  status : VARCHAR(30)\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\nentity \&quot;employees\&quot; as employees {\n  * employee_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  user_id : BIGINT &lt;&lt;FK, UQ&gt;&gt;\n  full_name : VARCHAR(150)\n  employee_type : VARCHAR(50) NULL\n  phone : VARCHAR(30) NULL\n  base_lat : NUMERIC(9,6) NULL\n  base_lon : NUMERIC(9,6) NULL\n  max_daily_minutes : INTEGER\n  status : VARCHAR(30)\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ==================================================\n&#39; 3. SKILLS\n&#39; ==================================================\n\nentity \&quot;skills\&quot; as skills {\n  * skill_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  skill_name : VARCHAR(100) &lt;&lt;UQ&gt;&gt;\n  description : TEXT NULL\n  status : VARCHAR(30)\n}\n\nentity \&quot;employee_skills\&quot; as employee_skills {\n  * employee_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  * skill_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  --\n  level : SMALLINT\n  valid_from : DATE NULL\n  valid_to : DATE NULL\n}\n\n&#39; ==================================================\n&#39; 4. SERVICES AND SERVICE REQUESTS\n&#39; ==================================================\n\nentity \&quot;services\&quot; as services {\n  * service_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  service_name : VARCHAR(150) &lt;&lt;UQ&gt;&gt;\n  default_duration : INTEGER\n  base_price : NUMERIC(12,2) NULL\n  active : BOOLEAN\n}\n\nentity \&quot;service_required_skills\&quot; as service_required_skills {\n  * service_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  * skill_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  --\n  min_level : SMALLINT\n  mandatory : BOOLEAN\n}\n\nentity \&quot;service_requests\&quot; as service_requests {\n  * request_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  customer_id : BIGINT &lt;&lt;FK&gt;&gt;\n  service_id : BIGINT &lt;&lt;FK&gt;&gt;\n  preferred_start : TIMESTAMPTZ\n  preferred_end : TIMESTAMPTZ\n  address : TEXT\n  lat : NUMERIC(9,6) NULL\n  lon : NUMERIC(9,6) NULL\n  complexity_level : SMALLINT NULL\n  priority : SMALLINT\n  predicted_duration : INTEGER NULL\n  status : VARCHAR(40)\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ==================================================\n&#39; 5. WORKFORCE AVAILABILITY AND LEAVE\n&#39; ==================================================\n\nentity \&quot;employee_availability\&quot; as employee_availability {\n  * availability_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  employee_id : BIGINT &lt;&lt;FK&gt;&gt;\n  date : DATE\n  start_time : TIME\n  end_time : TIME\n  availability_type : VARCHAR(30)\n}\n\nentity \&quot;leave_requests\&quot; as leave_requests {\n  * leave_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  employee_id : BIGINT &lt;&lt;FK&gt;&gt;\n  from_time : TIMESTAMPTZ\n  to_time : TIMESTAMPTZ\n  status : VARCHAR(30)\n  reason : TEXT NULL\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; ==================================================\n&#39; 6. SCHEDULING AND ASSIGNMENTS\n&#39; ==================================================\n\nentity \&quot;schedule_versions\&quot; as schedule_versions {\n  * version_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  schedule_date : DATE\n  created_by : BIGINT &lt;&lt;FK&gt;&gt;\n  algorithm : VARCHAR(100)\n  parameters_json : JSONB NULL\n  created_at : TIMESTAMPTZ\n}\n\nentity \&quot;assignments\&quot; as assignments {\n  * assignment_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  request_id : BIGINT &lt;&lt;FK&gt;&gt;\n  employee_id : BIGINT &lt;&lt;FK&gt;&gt;\n  version_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  prediction_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  scheduled_start : TIMESTAMPTZ\n  scheduled_end : TIMESTAMPTZ\n  assignment_status : VARCHAR(40)\n  recommendation_score : NUMERIC(8,4) NULL\n  explanation : TEXT NULL\n  confirmed_by : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  confirmed_at : TIMESTAMPTZ NULL\n  override_reason : TEXT NULL\n  created_at : TIMESTAMPTZ\n  updated_at : TIMESTAMPTZ\n}\n\nentity \&quot;travel_matrix\&quot; as travel_matrix {\n  * travel_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  from_id : BIGINT\n  to_id : BIGINT\n  distance_km : NUMERIC(10,2)\n  travel_minutes : INTEGER\n  source : VARCHAR(100) NULL\n  calculated_at : TIMESTAMPTZ\n}\n\n&#39; ==================================================\n&#39; 7. SERVICE EXECUTION RESULTS AND RATINGS\n&#39; ==================================================\n\nentity \&quot;service_results\&quot; as service_results {\n  * service_result_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  assignment_id : BIGINT &lt;&lt;FK, UQ&gt;&gt;\n  actual_start : TIMESTAMPTZ\n  actual_end : TIMESTAMPTZ\n  actual_duration : INTEGER\n  status : VARCHAR(30)\n  travel_minutes : INTEGER NULL\n  outcome : TEXT NULL\n  notes : TEXT NULL\n}\n\nentity \&quot;ratings\&quot; as ratings {\n  * rating_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  assignment_id : BIGINT &lt;&lt;FK, UQ&gt;&gt;\n  score : SMALLINT\n  comment : TEXT NULL\n  created_at : TIMESTAMPTZ\n}\n\n&#39; ==================================================\n&#39; 8. AI MODEL AND PREDICTIONS\n&#39; ==================================================\n\nentity \&quot;ai_model_versions\&quot; as ai_model_versions {\n  * model_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  task : VARCHAR(100)\n  algorithm : VARCHAR(100)\n  version : VARCHAR(50)\n  feature_schema_json : JSONB\n  metrics_json : JSONB NULL\n  artifact_path : TEXT NULL\n  trained_at : TIMESTAMPTZ\n  active : BOOLEAN\n}\n\nentity \&quot;ai_predictions\&quot; as ai_predictions {\n  * prediction_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  request_id : BIGINT &lt;&lt;FK&gt;&gt;\n  model_id : BIGINT &lt;&lt;FK&gt;&gt;\n  predicted_duration : INTEGER\n  prediction_meta_json : JSONB NULL\n  created_at : TIMESTAMPTZ\n}\n\nentity \&quot;recommendation_logs\&quot; as recommendation_logs {\n  * recommendation_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  request_id : BIGINT &lt;&lt;FK&gt;&gt;\n  employee_id : BIGINT &lt;&lt;FK&gt;&gt;\n  version_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  rank : INTEGER\n  score : NUMERIC(8,4)\n  score_breakdown_json : JSONB NULL\n  rejected_reason : TEXT NULL\n  created_at : TIMESTAMPTZ\n}\n\n&#39; ==================================================\n&#39; 9. SYSTEM MANAGEMENT\n&#39; ==================================================\n\nentity \&quot;notifications\&quot; as notifications {\n  * notification_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  user_id : BIGINT &lt;&lt;FK&gt;&gt;\n  type : VARCHAR(50)\n  message : TEXT\n  read_at : TIMESTAMPTZ NULL\n  created_at : TIMESTAMPTZ\n}\n\nentity \&quot;audit_logs\&quot; as audit_logs {\n  * audit_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  user_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  action : VARCHAR(100)\n  entity_type : VARCHAR(100)\n  entity_id : BIGINT NULL\n  timestamp : TIMESTAMPTZ\n  metadata_json : JSONB NULL\n}\n\n&#39; ==================================================\n&#39; 10. RELATIONSHIPS: AUTHENTICATION AND RBAC\n&#39; ==================================================\n\nroles ||--o{ users : role_id\n\nroles ||--o{ role_permissions : role_id\npermissions ||--o{ role_permissions : permission_id\n\nusers ||--o| employees : user_id\nusers ||--o| customers : user_id\n\n&#39; ==================================================\n&#39; 11. RELATIONSHIPS: CUSTOMER REQUESTS AND SERVICES\n&#39; ==================================================\n\ncustomers ||--o{ service_requests : customer_id\nservices ||--o{ service_requests : service_id\n\nservices ||--o{ service_required_skills : service_id\nskills ||--o{ service_required_skills : skill_id\n\nemployees ||--o{ employee_skills : employee_id\nskills ||--o{ employee_skills : skill_id\n\n&#39; ==================================================\n&#39; 12. RELATIONSHIPS: WORKFORCE\n&#39; ==================================================\n\nemployees ||--o{ employee_availability : employee_id\nemployees ||--o{ leave_requests : employee_id\n\n&#39; ==================================================\n&#39; 13. RELATIONSHIPS: SCHEDULING AND HUMAN REVIEW\n&#39; ==================================================\n\nusers ||--o{ schedule_versions : created_by\n\nservice_requests ||--o{ assignments : request_id\nemployees ||--o{ assignments : employee_id\n\nschedule_versions ||--o{ assignments : version_id\nai_predictions ||--o{ assignments : prediction_id\nusers ||--o{ assignments : confirmed_by\n\n&#39; ==================================================\n&#39; 14. RELATIONSHIPS: SERVICE EXECUTION AND RATINGS\n&#39; ==================================================\n\nassignments ||--o| service_results : assignment_id\nassignments ||--o| ratings : assignment_id\n\n&#39; ==================================================\n&#39; 15. RELATIONSHIPS: AI PREDICTION\n&#39; ==================================================\n\nservice_requests ||--o{ ai_predictions : request_id\nai_model_versions ||--o{ ai_predictions : model_id\n\n&#39; ==================================================\n&#39; 16. RELATIONSHIPS: RECOMMENDATION LOGS\n&#39; ==================================================\n\nservice_requests ||--o{ recommendation_logs : request_id\nemployees ||--o{ recommendation_logs : employee_id\nschedule_versions ||--o{ recommendation_logs : version_id\n\n&#39; ==================================================\n&#39; 17. RELATIONSHIPS: SYSTEM MANAGEMENT\n&#39; ==================================================\n\nusers ||--o{ notifications : user_id\nusers ||--o{ audit_logs : user_id\n\n&#39; travel_matrix.from_id and to_id intentionally have no FK.\n&#39; No relationship is drawn until the referenced entity is specified.\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LFInUypio7fHRvjFe--4-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="LFInUypio7fHRvjFe--4-266" edge="1" parent="LFInUypio7fHRvjFe--4-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-150" y="1782" as="sourcePoint" />
            <mxPoint x="-160" y="1782" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ERD v2 - Home Healthcare Management System\n\nhide circle\nskinparam linetype ortho\nskinparam defaultFontSize 14\nskinparam titleFontSize 22\nskinparam titleFontWeight bold\nskinparam entityFontSize 14\nskinparam ArrowFontSize 12\n\nskinparam entity {\n  BackgroundColor #F8FAFC\n  BorderColor #475569\n  FontColor #0F172A\n}\n\nskinparam ArrowColor #475569\n\n&#39; ==================================================\n&#39; 1. AUTHENTICATION AND RBAC\n&#39; ==================================================\n\nentity \&quot;users\&quot; as users {\n  * user_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  role_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  username : VARCHAR(100) &lt;&lt;UQ, NOT NULL&gt;&gt;\n  email : VARCHAR(255) &lt;&lt;UQ, NOT NULL&gt;&gt;\n  password_hash : TEXT &lt;&lt;NOT NULL&gt;&gt;\n  status : VARCHAR(30) &lt;&lt;NOT NULL&gt;&gt;\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  updated_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;roles\&quot; as roles {\n  * role_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  role_name : VARCHAR(100) &lt;&lt;UQ, NOT NULL&gt;&gt;\n  description : TEXT NULL\n}\n\nentity \&quot;permissions\&quot; as permissions {\n  * permission_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  permission_code : VARCHAR(100) &lt;&lt;UQ, NOT NULL&gt;&gt;\n  description : TEXT NULL\n}\n\nentity \&quot;role_permissions\&quot; as role_permissions {\n  * role_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  * permission_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n}\n\n&#39; ==================================================\n&#39; 2. CUSTOMERS AND EMPLOYEES\n&#39; ==================================================\n\nentity \&quot;customers\&quot; as customers {\n  * customer_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  user_id : BIGINT &lt;&lt;FK, UQ, NULL&gt;&gt;\n  full_name : VARCHAR(150) &lt;&lt;NOT NULL&gt;&gt;\n  phone : VARCHAR(30) NULL\n  date_of_birth : DATE NULL\n  address : TEXT NULL\n  lat : NUMERIC(9,6) NULL\n  lon : NUMERIC(9,6) NULL\n  status : VARCHAR(30) &lt;&lt;NOT NULL&gt;&gt;\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  updated_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;employees\&quot; as employees {\n  * employee_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  user_id : BIGINT &lt;&lt;FK, UQ, NOT NULL&gt;&gt;\n  full_name : VARCHAR(150) &lt;&lt;NOT NULL&gt;&gt;\n  employee_type : VARCHAR(50) NULL\n  phone : VARCHAR(30) NULL\n  base_lat : NUMERIC(9,6) NULL\n  base_lon : NUMERIC(9,6) NULL\n  max_daily_minutes : INTEGER &lt;&lt;NOT NULL&gt;&gt;\n  status : VARCHAR(30) &lt;&lt;NOT NULL&gt;&gt;\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  updated_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\n&#39; ==================================================\n&#39; 3. SKILLS\n&#39; ==================================================\n\nentity \&quot;skills\&quot; as skills {\n  * skill_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  skill_name : VARCHAR(100) &lt;&lt;UQ, NOT NULL&gt;&gt;\n  description : TEXT NULL\n  status : VARCHAR(30) &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;employee_skills\&quot; as employee_skills {\n  * employee_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  * skill_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  --\n  level : SMALLINT &lt;&lt;NOT NULL&gt;&gt;\n  valid_from : DATE NULL\n  valid_to : DATE NULL\n}\n\n&#39; ==================================================\n&#39; 4. SERVICES AND SERVICE REQUESTS\n&#39; ==================================================\n\nentity \&quot;services\&quot; as services {\n  * service_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  service_name : VARCHAR(150) &lt;&lt;UQ, NOT NULL&gt;&gt;\n  description : TEXT NULL\n  default_duration : INTEGER &lt;&lt;NOT NULL&gt;&gt;\n  base_price : NUMERIC(12,2) NULL\n  active : BOOLEAN &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;service_required_skills\&quot; as service_required_skills {\n  * service_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  * skill_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  --\n  min_level : SMALLINT &lt;&lt;NOT NULL&gt;&gt;\n  mandatory : BOOLEAN &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;service_requests\&quot; as service_requests {\n  * request_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  customer_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  service_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  preferred_start : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  preferred_end : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  address : TEXT &lt;&lt;NOT NULL&gt;&gt;\n  lat : NUMERIC(9,6) NULL\n  lon : NUMERIC(9,6) NULL\n  complexity_level : SMALLINT NULL\n  priority : SMALLINT &lt;&lt;NOT NULL&gt;&gt;\n  predicted_duration : INTEGER NULL\n  status : VARCHAR(40) &lt;&lt;NOT NULL&gt;&gt;\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  updated_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\n&#39; ==================================================\n&#39; 5. WORKFORCE AVAILABILITY AND LEAVE\n&#39; ==================================================\n\nentity \&quot;employee_availability\&quot; as employee_availability {\n  * availability_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  employee_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  date : DATE &lt;&lt;NOT NULL&gt;&gt;\n  start_time : TIME &lt;&lt;NOT NULL&gt;&gt;\n  end_time : TIME &lt;&lt;NOT NULL&gt;&gt;\n  availability_type : VARCHAR(30) &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;leave_requests\&quot; as leave_requests {\n  * leave_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  employee_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  from_time : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  to_time : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  status : VARCHAR(30) &lt;&lt;NOT NULL&gt;&gt;\n  reason : TEXT NULL\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  updated_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\n&#39; ==================================================\n&#39; 6. SCHEDULING AND ASSIGNMENTS\n&#39; ==================================================\n\nentity \&quot;schedule_versions\&quot; as schedule_versions {\n  * version_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  schedule_date : DATE &lt;&lt;NOT NULL&gt;&gt;\n  created_by : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  algorithm : VARCHAR(100) &lt;&lt;NOT NULL&gt;&gt;\n  parameters_json : JSONB NULL\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;assignments\&quot; as assignments {\n  * assignment_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  request_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  employee_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  version_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  prediction_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  scheduled_start : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  scheduled_end : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  assignment_status : VARCHAR(40) &lt;&lt;NOT NULL&gt;&gt;\n  recommendation_score : NUMERIC(8,4) NULL\n  explanation : TEXT NULL\n  confirmed_by : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  confirmed_at : TIMESTAMPTZ NULL\n  override_reason : TEXT NULL\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  updated_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;travel_matrix\&quot; as travel_matrix {\n  * travel_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  from_id : BIGINT &lt;&lt;NOT NULL&gt;&gt;\n  to_id : BIGINT &lt;&lt;NOT NULL&gt;&gt;\n  distance_km : NUMERIC(10,2) &lt;&lt;NOT NULL&gt;&gt;\n  travel_minutes : INTEGER &lt;&lt;NOT NULL&gt;&gt;\n  source : VARCHAR(100) NULL\n  calculated_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\n&#39; ==================================================\n&#39; 7. SERVICE EXECUTION RESULTS AND RATINGS\n&#39; ==================================================\n\nentity \&quot;service_results\&quot; as service_results {\n  * service_result_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  assignment_id : BIGINT &lt;&lt;FK, UQ, NOT NULL&gt;&gt;\n  actual_start : TIMESTAMPTZ NULL\n  actual_end : TIMESTAMPTZ NULL\n  actual_duration : INTEGER NULL\n  status : VARCHAR(30) &lt;&lt;NOT NULL&gt;&gt;\n  outcome : TEXT NULL\n  notes : TEXT NULL\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  updated_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;ratings\&quot; as ratings {\n  * rating_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  assignment_id : BIGINT &lt;&lt;FK, UQ, NOT NULL&gt;&gt;\n  score : SMALLINT &lt;&lt;NOT NULL&gt;&gt;\n  comment : TEXT NULL\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\n&#39; ==================================================\n&#39; 8. AI MODEL AND PREDICTIONS\n&#39; ==================================================\n\nentity \&quot;ai_model_versions\&quot; as ai_model_versions {\n  * model_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  task : VARCHAR(100) &lt;&lt;NOT NULL&gt;&gt;\n  algorithm : VARCHAR(100) &lt;&lt;NOT NULL&gt;&gt;\n  version : VARCHAR(50) &lt;&lt;NOT NULL&gt;&gt;\n  feature_schema_json : JSONB &lt;&lt;NOT NULL&gt;&gt;\n  metrics_json : JSONB NULL\n  artifact_path : TEXT NULL\n  trained_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  active : BOOLEAN &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;ai_predictions\&quot; as ai_predictions {\n  * prediction_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  request_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  model_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  predicted_duration : INTEGER &lt;&lt;NOT NULL&gt;&gt;\n  prediction_meta_json : JSONB NULL\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;recommendation_logs\&quot; as recommendation_logs {\n  * recommendation_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  request_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  employee_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  version_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  rank : INTEGER &lt;&lt;NOT NULL&gt;&gt;\n  score : NUMERIC(8,4) &lt;&lt;NOT NULL&gt;&gt;\n  score_breakdown_json : JSONB NULL\n  rejected_reason : TEXT NULL\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\n&#39; ==================================================\n&#39; 9. SYSTEM MANAGEMENT\n&#39; ==================================================\n\nentity \&quot;notifications\&quot; as notifications {\n  * notification_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  user_id : BIGINT &lt;&lt;FK, NOT NULL&gt;&gt;\n  type : VARCHAR(50) &lt;&lt;NOT NULL&gt;&gt;\n  message : TEXT &lt;&lt;NOT NULL&gt;&gt;\n  read_at : TIMESTAMPTZ NULL\n  created_at : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n}\n\nentity \&quot;audit_logs\&quot; as audit_logs {\n  * audit_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n  --\n  user_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  action : VARCHAR(100) &lt;&lt;NOT NULL&gt;&gt;\n  entity_type : VARCHAR(100) &lt;&lt;NOT NULL&gt;&gt;\n  entity_id : BIGINT NULL\n  timestamp : TIMESTAMPTZ &lt;&lt;NOT NULL&gt;&gt;\n  metadata_json : JSONB NULL\n}\n\n&#39; ==================================================\n&#39; 10. RELATIONSHIPS AND CARDINALITIES\n&#39; ==================================================\n\n&#39; Authentication and RBAC\nroles ||--o{ users : role_id\nroles ||--o{ role_permissions : role_id\npermissions ||--o{ role_permissions : permission_id\n\n&#39; User profiles\nusers ||--o| employees : user_id\nusers |o--o| customers : user_id\n\n&#39; Customers and service requests\ncustomers ||--o{ service_requests : customer_id\nservices ||--o{ service_requests : service_id\n\n&#39; Services and required skills\nservices ||--o{ service_required_skills : service_id\nskills ||--o{ service_required_skills : skill_id\n\n&#39; Employee skills\nemployees ||--o{ employee_skills : employee_id\nskills ||--o{ employee_skills : skill_id\n\n&#39; Availability and leave\nemployees ||--o{ employee_availability : employee_id\nemployees ||--o{ leave_requests : employee_id\n\n&#39; Schedule versions\nusers ||--o{ schedule_versions : created_by\n\n&#39; Assignments\nservice_requests ||--o{ assignments : request_id\nemployees ||--o{ assignments : employee_id\nschedule_versions |o--o{ assignments : version_id\nai_predictions |o--o{ assignments : prediction_id\nusers |o--o{ assignments : confirmed_by\n\n&#39; One assignment has at most one result and one rating\nassignments ||--o| service_results : assignment_id\nassignments ||--o| ratings : assignment_id\n\n&#39; AI prediction history\nservice_requests ||--o{ ai_predictions : request_id\nai_model_versions ||--o{ ai_predictions : model_id\n\n&#39; Recommendation history by schedule version\nservice_requests ||--o{ recommendation_logs : request_id\nemployees ||--o{ recommendation_logs : employee_id\nschedule_versions |o--o{ recommendation_logs : version_id\n\n&#39; Notifications and audit logs\nusers ||--o{ notifications : user_id\nusers |o--o{ audit_logs : user_id\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LFInUypio7fHRvjFe--4-532">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=32;" vertex="1">
