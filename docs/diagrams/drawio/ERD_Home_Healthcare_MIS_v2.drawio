        <UserObject label="role_name : VARCHAR(100) «UQ, NOT NULL»" plantUmlId="mb_18" plantUmlBaseStyle="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;fillColor=none;strokeColor=none;fontSize=14;fontColor=#000000;fontStyle=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;" plantUmlBaseValue="role_name : VARCHAR(100) «UQ, NOT NULL»" id="LFInUypio7fHRvjFe--4-549">
